# このファイルを .env にコピーして値を設定してください (.env は Git 管理外)

# PostgreSQL (docker-compose のローカルDB、ホストの 5432 衝突回避のため 5433)
DATABASE_URL="postgresql://salon:salon@localhost:5433/salon_story?schema=public"

# BetterAuth (BETTER_AUTH_SECRET は `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 等で生成)
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# 新規登録時の管理者承認をスキップするか (ローカル開発専用。本番では必ず "false")
AUTH_SKIP_APPROVAL="true"

# S3 / MinIO (ローカルは MinIO、本番は S3_ENDPOINT を空にして AWS S3 を利用)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET="salon-backgrounds"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# メール送信 (SMTP_HOST が空の場合は送信せず、サーバーログと管理者画面の「ローカル送信メール」に表示)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="salon-story@example.com"
