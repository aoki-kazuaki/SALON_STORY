# このファイルを .env にコピーして値を設定してください (.env は Git 管理外)
# 本番 (Vercel) では同じキーを Vercel の Project Settings → Environment Variables に設定します。
# 各項目の「本番」コメントが Vercel + Neon + AWS S3 + Gmail SMTP 構成での設定例です。

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# アプリ実行時の接続URL
#   ローカル: docker-compose の DB (ホストの 5432 衝突回避のため 5433)
#   本番    : Neon の「Pooled connection」(ホスト名に -pooler を含む) の URL。末尾に ?sslmode=require
DATABASE_URL="postgresql://salon:salon@localhost:5433/salon_story?schema=public"

# マイグレーション (prisma migrate deploy) 用の直接接続URL
#   ローカル: 空のままで OK (DATABASE_URL を利用)
#   本番    : Neon の「Direct connection」(-pooler を含まない) の URL
DIRECT_DATABASE_URL=""

# -----------------------------------------------------------------------------
# BetterAuth
# -----------------------------------------------------------------------------
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 等で生成 (本番はローカルと別の値にする)
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# アプリの公開URL (本番: https://<プロジェクト名>.vercel.app 等。メール内のリンクにも使われる)
BETTER_AUTH_URL="http://localhost:3000"

# 新規登録時の管理者承認をスキップするか (ローカル開発専用。本番では必ず "false")
AUTH_SKIP_APPROVAL="true"

# -----------------------------------------------------------------------------
# S3 / MinIO
# -----------------------------------------------------------------------------
# ローカルは MinIO。本番 AWS S3 は S3_ENDPOINT を空にし、対象バケットのみ操作できる IAM ユーザーのアクセスキーを設定する
# (Cloudflare R2 等の S3 互換ストレージも S3_ENDPOINT に URL を指定すれば利用可能)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET="salon-backgrounds"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# -----------------------------------------------------------------------------
# メール送信 (SMTP)
# -----------------------------------------------------------------------------
# SMTP_HOST が空の場合は送信せず、サーバーログと管理者画面の「ローカル送信メール」に表示 (ローカル開発用)
# 本番 (Gmail SMTP・無料・1日500通程度まで):
#   SMTP_HOST="smtp.gmail.com" / SMTP_PORT="465" / SMTP_USER="<Gmail アドレス>"
#   SMTP_PASSWORD="<Google アカウントの「アプリ パスワード」16桁 (通常のログインPWではない)>"
#   MAIL_FROM="サロン空き状況 <Gmail アドレス>" (Gmail は SMTP_USER 以外の差出人に書き換えられるため同じアドレスにする)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="salon-story@example.com"
