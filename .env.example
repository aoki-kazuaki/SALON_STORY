# このファイルを .env にコピーして値を設定してください (.env は Git 管理外)

# PostgreSQL (docker-compose のローカルDB)
DATABASE_URL="postgresql://salon:salon@localhost:5432/salon_story?schema=public"

# BetterAuth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# S3 / MinIO (ローカルは MinIO、本番は S3_ENDPOINT を空にして AWS S3 を利用)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET="salon-backgrounds"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
